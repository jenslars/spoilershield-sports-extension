{
  "manifest_version": 2,
  "name": "SpoilerShield",
  "version": "0.2",
  "description": "SpoilerShield is an extension that will block spoilers from your selected sports and games",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self';",
  "browser_action": {
    "default_popup": "public/popup.html",
    "default_icon": "public/SpoilerShield.png",
    "default_title": "SpoilerShield"
  },
  "icons": {
    "48": "public/SpoilerShield.png"
  },
  "background": {
    "scripts": ["/src/background/background.js"]
  }
}
